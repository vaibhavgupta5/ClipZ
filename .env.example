# Copy to .env and fill in. Every key here must match a field in app/settings.py Settings.
# Tiger Data (Postgres + TimescaleDB). Put your Tiger Cloud service URL here (sslmode=require);
# the default is the local timescale container from `make dev`, which tests always use.
TIGER_DATABASE_URL=postgresql://reelforge:reelforge@localhost:5433/reelforge
TIGER_SCHEMA=public
# Tiger Cloud service for the Docker stack (api/worker); empty = local tiger container.
TIGER_CLOUD_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./upload            # raw uploads, deleted once ingest succeeds
WORK_DIR=./work                # masters/proxies/caches; ./work/<project> deleted after final export
EDITED_DIR=./editedVideo       # previews + final exports (kept)
MAX_UPLOAD_MB=1024
GEMINI_API_KEY=
# ElevenLabs: generated SFX, voiceover, dubbing (empty = those tools are hidden)
ELEVENLABS_API_KEY=
# free | paid (free-plan output is personal use + credited, ADR-017)
ELEVENLABS_PLAN=free
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite   # tried in order when the primary quota is exhausted
GEMINI_THINKING_LEVEL=                # empty = model default (2.5 Flash-Lite rejects levels)
WHISPER_MODEL=small                  # tiny|base|small|medium|large-v3 (downloaded on first use)
CHAT_PREVIEW_WAIT_S=180            # chat SSE waits this long for preview_ready
ASSETS_DIR=./assets                  # local music/gif/image/meme libraries + manifests
MAX_VIDEO_SECONDS=90
DEFAULT_CAPTION_SCRIPT=devanagari
GPU_WORKER_URL=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO