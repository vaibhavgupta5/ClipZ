# Copy to .env and fill in. Every key here must match a field in app/settings.py Settings.
MONGODB_URL=mongodb://localhost:27018
MONGODB_DB=reelforge
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./upload            # raw uploads, deleted once ingest succeeds
WORK_DIR=./work                # masters/proxies/caches; ./work/<project> deleted after final export
EDITED_DIR=./editedVideo       # previews + final exports (kept)
MAX_UPLOAD_MB=1024
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low            # minimal|low|medium|high
WHISPER_MODEL=small                  # tiny|base|small|medium|large-v3 (downloaded on first use)
CHAT_PREVIEW_WAIT_S=180            # chat SSE waits this long for preview_ready
ASSETS_DIR=./assets                  # local music/gif/image/meme libraries + manifests
MAX_VIDEO_SECONDS=90
DEFAULT_CAPTION_SCRIPT=devanagari
GPU_WORKER_URL=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
